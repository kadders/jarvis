# CUDA image for QLoRA/DPO on gpu-rig (Pascal GTX 1070 / CUDA 11.8).
# Keep the base image's torch — do not let pip upgrade to CUDA 12/13 wheels.
#
# Build:
#   docker build -t 192.168.86.120:32000/jarvis_llm_train_cuda:latest \
#     -f training/Dockerfile.cuda .
#   docker push 192.168.86.120:32000/jarvis_llm_train_cuda:latest
FROM pytorch/pytorch:2.2.2-cuda11.8-cudnn8-runtime

WORKDIR /app

# git: export_ollama_tuned clones llama.cpp for convert_hf_to_gguf.py
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY training/constraints-cuda.txt /tmp/constraints-cuda.txt
RUN pip install --no-cache-dir --upgrade "pip<25" \
    && pip install --no-cache-dir -c /tmp/constraints-cuda.txt \
        "transformers>=4.44.0,<4.48" \
        "peft>=0.12.0,<0.14" \
        "trl>=0.9.0,<0.12" \
        "datasets>=2.20.0,<3.1" \
        "bitsandbytes==0.43.3" \
        "accelerate>=0.33.0,<1.0" \
        "rich>=13.0.0" \
    && python -c "import torch; assert torch.__version__.startswith('2.2'), torch.__version__; print('torch', torch.__version__, 'cuda', torch.version.cuda)"

COPY training/ /app/training/
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/data/adapters/hf

ENTRYPOINT ["python", "-m", "training.train_dpo"]
CMD ["--dry-run", "--min-pairs", "1", "--preferences", "/data/adapters/preferences.jsonl", "--out-dir", "/data/adapters/run"]
