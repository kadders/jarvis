# Copy to deploy.env (gitignored) or export before ./deploy.sh.
# Machine-specific values belong here or in deploy/profiles/*.env — not in stacks.

# Container registry the cluster can pull from (no trailing slash).
REGISTRY=localhost:32000

# Tag for jarvis_* images built by deploy.sh.
IMAGE_TAG=latest

# If set, injected into the temporary kustomize wrapper when applying portable overlays.
# Leave empty to use whatever namespace the overlay declares (if any).
# NAMESPACE=jarvis-llm

# kubectl binary (default: kubectl).
# KUBECTL=kubectl

# Optional: default profile when --profile is omitted (e.g. gpu-rig, microk8s).
# DEPLOY_PROFILE=

# Optional: force an overlay path for a stack (overrides profile + stack default).
# STACK_OVERLAY_tap_testing=k8s/overlays/my-site/telemetry
# STACK_OVERLAY_core=k8s/overlays/my-site
