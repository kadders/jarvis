{
  "mcpServers": {
    "jarvis": {
      "command": "/media/kad/data/repositories/jarvis/venv/bin/python",
      "args": ["-m", "jarvis_mcp"],
      "cwd": "/media/kad/data/repositories/jarvis",
      "env": {
        "JARVIS_LLM_BASE_URL": "http://llm.jarvis.lan/api/v1",
        "JARVIS_MCP_TRANSPORT": "stdio",
        "JARVIS_LLM_TIMEOUT_S": "120"
      }
    },
    "fusion360": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/faust-machines/fusion360-mcp-server",
        "--with",
        "mcp<2",
        "fusion360-mcp-server",
        "--mode",
        "socket"
      ],
      "env": {
        "FUSION_MCP_HOST": "192.168.122.166"
      }
    }
  }
}
