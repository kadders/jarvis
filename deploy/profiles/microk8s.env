# Single-node MicroK8s with built-in registry on localhost:32000.

: "${REGISTRY:=localhost:32000}"

# Core LLM bundle uses the microk8s image-rewrite overlay.
STACK_OVERLAY_core=k8s/overlays/microk8s

# Other stacks keep portable defaults unless you add site overlays.
# STACK_OVERLAY_tap_testing=k8s/overlays/tap-testing
