STACK_NAME=tap-collector
STACK_KIND=service
STACK_PARENT=tap-testing
STACK_COMPLETE=1
STACK_DESCRIPTION="Tap collector MQTT ingest API and session UI"
STACK_OVERLAY_DEFAULT=k8s/overlays/tap-testing
STACK_IMAGES=(
  "jarvis_tap_collector|tap_collector/Dockerfile|tap_collector"
)
STACK_DEPLOYMENTS=(tap-collector)
