# Portable MQTT + tap ingest stack for tap-testing clients (Pi/SBC publishers).
# No MetalLB, NFS, or lab hostnames — those belong in a profile overlay override.

STACK_NAME=tap-testing
STACK_ALIASES="telemetry"
STACK_KIND=stack
STACK_COMPLETE=1
STACK_DESCRIPTION="MQTT broker + tap collector/stream + telemetry bridge"
STACK_OVERLAY_DEFAULT=k8s/overlays/tap-testing
STACK_IMAGES=(
  "jarvis_tap_collector|tap_collector/Dockerfile|tap_collector"
  "jarvis_tap_stream|tap_stream/Dockerfile|tap_stream"
  "jarvis_telemetry_bridge|telemetry_bridge/Dockerfile|telemetry_bridge"
)
STACK_DEPLOYMENTS=(tap-collector tap-stream telemetry-bridge)
