# Lab PoC on gpu-rig. Does not change stack image recipes — only overlay paths + kube env.
# Values use := so an existing deploy.env / environment wins.

: "${REGISTRY:=192.168.86.120:32000}"
# Do not set NAMESPACE here — overlays declare jarvis-llm / health as needed.

# Site-specific overlays (MetalLB, NFS, pinned IPs).
STACK_OVERLAY_tap_testing=k8s/overlays/gpu-rig-telemetry
STACK_OVERLAY_core=k8s/overlays/gpu-rig
STACK_OVERLAY_ui=k8s/overlays/gpu-rig-ui
STACK_OVERLAY_health=k8s/overlays/gpu-rig-health
STACK_OVERLAY_dns=k8s/overlays/gpu-rig-dns

# Sourced only for this profile (not for portable defaults).
DEPLOY_KUBECONFIG_ENV="${HOME}/.config/gpu-rig-kubectl.env"
